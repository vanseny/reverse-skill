{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "reverse-skill",
  "owner": {
    "name": "vanseny",
    "url": "https://github.com/vanseny"
  },
  "metadata": {
    "description": "Self-hosted local marketplace for reverse-skill and reverse-engineering plugins. Served from a container; plugin payloads are fetched over Smart HTTP or GitHub.",
    "version": "1.0.3"
  },
  "plugins": [
    {
      "name": "reverse-skill",
      "source": {
        "source": "url",
        "url": "__BASE_URL__/reverse-skill.git"
      },
      "description": "Full reverse-skill router with the complete specialist skill catalog. Scope-gated: authorization comes from the case scope contract, never from the plugin.",
      "version": "1.0.3",
      "homepage": "https://github.com/vanseny/reverse-skill",
      "repository": "https://github.com/vanseny/reverse-skill",
      "category": "security",
      "license": "MIT"
    },
    {
      "name": "rea",
      "source": {
        "source": "url",
        "url": "__BASE_URL__/rea.git"
      },
      "strict": false,
      "description": "Reverse engineer anything with agents, from app behavior down to native binaries. Covers native, managed, Electron/JS, Android, and browser targets.",
      "version": "5.0.0",
      "homepage": "https://github.com/shijianzhong/rea",
      "repository": "https://github.com/shijianzhong/rea",
      "category": "security",
      "license": "Apache-2.0",
      "keywords": [
        "rea",
        "reverse-engineering",
        "binary-analysis",
        "decompilation",
        "ghidra",
        "ida",
        "android-reverse"
      ],
      "skills": [
        "./skills/reverse-engineer-anything"
      ],
      "mcpServers": {
        "rea": {
          "command": "npx",
          "args": [
            "-y",
            "rea-agents@5.0.0",
            "mcp"
          ]
        }
      }
    },
    {
      "name": "reverse-engineer-anything",
      "source": {
        "source": "url",
        "url": "__BASE_URL__/rea.git"
      },
      "strict": false,
      "description": "Reverse engineer anything with agents (alias for rea).",
      "version": "5.0.0",
      "homepage": "https://github.com/shijianzhong/rea",
      "repository": "https://github.com/shijianzhong/rea",
      "category": "security",
      "license": "Apache-2.0",
      "skills": [
        "./skills/reverse-engineer-anything"
      ],
      "mcpServers": {
        "rea": {
          "command": "npx",
          "args": [
            "-y",
            "rea-agents@5.0.0",
            "mcp"
          ]
        }
      }
    }
  ]
}
